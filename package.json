{
  "name": "custartutor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CUSTAR Tutor: NERDC-aligned LMS with an interactive AI tutor for Nigerian Primary 1-6.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && node scripts/check-peer-deps.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "node scripts/vendor-schema.mjs && node scripts/vendor-authoring.mjs",
    "vendor:check": "node scripts/vendor-schema.mjs --check && node scripts/vendor-authoring.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
